# Ephapsys SDK configuration reference.
# Copy to .env in your own project and fill in the values you need.
# Only the "Required" block is needed to get started; everything else has a
# working default and is shown commented out with that default.

# ===== Required: connection and credentials =====
# Ephapsys Ops Center API base URL.
AOC_BASE_URL=https://api.ephapsys.com

# Organization ID from the Ephapsys web app.
AOC_ORG_ID=org_xxxxxxxxx

# Provisioning token; exchanged for a short-lived device token at runtime.
AOC_PROVISIONING_TOKEN=boot_xxxxxxxxx

# Modulation token; needed only to register models and run modulation jobs.
AOC_MODULATION_TOKEN=mod_xxxxxxxxx

# Legacy aliases for AOC_BASE_URL, checked in this order if it is unset.
# Prefer AOC_BASE_URL; these exist for backward compatibility only.
# AOC_API_URL=
# EPHAPSYS_API_URL=

# ===== Agent and template selection =====
# Agent template ID to run. Leave blank to resolve from local state.
AGENT_TEMPLATE_ID=

# Stable identifiers. Both are derived automatically when unset.
# EPHAPSYS_AGENT_ID=
# EPHAPSYS_DEVICE_ID=

# ===== Hardware anchor =====
# Identity binding: tpm | hsm | tee | none. Use "none" for dev and test.
# tpm and tee force a real hardware attestation path.
PERSONALIZE_ANCHOR=none

# Escape hatches for development only. Never enable in production.
# EPHAPSYS_ALLOW_INSECURE_PERSONALIZE=0
# EPHAPSYS_ALLOW_INSECURE_TPM=0

# TPM PCR selection, e.g. "sha256:0,1,2". Unset uses the SDK default.
# TPM_PCR_SPEC=

# ===== HSM anchor (only when PERSONALIZE_ANCHOR=hsm) =====
# HSM_KMS_KEY=projects/YOUR_PROJECT/locations/YOUR_REGION/keyRings/YOUR_RING/cryptoKeys/YOUR_KEY/cryptoKeyVersions/1
# HSM_KMS_ENDPOINT=
# HSM_KMS_CREDENTIALS=
# HSM_HELPER=
# HSM_SLOT=
# HSM_KEY_LABEL=
# HSM_EVIDENCE_PATH=

# ===== Language inference tuning =====
# Output token cap. Template and model config take priority; falls back to 96.
# AOC_MAX_NEW_TOKENS=96
# AOC_LANGUAGE_TEMPERATURE=0.7
# AOC_LANGUAGE_TOP_P=0.9
# AOC_LANGUAGE_DO_SAMPLE=1
# AOC_LANGUAGE_USE_CHAT_TEMPLATE=1

# Input token cap per request.
# AOC_MAX_TOKENS=4096

# ===== GGUF / llama.cpp inference =====
# AOC_GGUF_MAX_NEW_TOKENS=256
# AOC_GGUF_CTX=2048
# AOC_LLAMA_CPP_CLI=llama-cli

# ===== Model download =====
# AOC_DOWNLOAD_WORKERS=4
# AOC_DOWNLOAD_CHUNK_KB=256
# AOC_DOWNLOAD_RETRIES=3
# AOC_DOWNLOAD_TIMEOUT=60
# AOC_DOWNLOAD_PROGRESS=1

# ===== Governance, policy and compliance =====
# AOC_POLICY_TELEMETRY=1
# AOC_REGULATED=0
# AOC_RESIDENCY_TAG=
# CURRENT_JURISDICTION=
# AOC_SAFETY_BLOCKLIST=
# AOC_AV_SCAN=0
# AOC_ALLOWED_AUDIO_MIME=audio/wav,audio/mpeg

# ===== Network and transport =====
# AOC_HTTP_TIMEOUT=30
# AOC_VERIFY_SSL=1
# AOC_NETWORK_ALLOWLIST=
# Client mTLS, for modulation against an mTLS-protected endpoint.
# AOC_MTLS_CERT=
# AOC_MTLS_KEY=

# ===== Agent-to-agent (A2A) =====
# AOC_A2A_TOKEN=a2a_xxxxxxxxx
# EPHAPSYS_AGENT_CLUSTER_IDS=
# A2A_SIGN_REQUESTS=0
# HMAC secret, required only when A2A_SIGN_REQUESTS=1.
# A2A_HMAC_SECRET=
# EPHAPSYS_A2A_JOURNAL_PATH=

# ===== Local state and diagnostics =====
# EPHAPSYS_STORAGE_DIR=.ephapsys_state
# EPHAPSYS_ECM_PATH=
# EPHAPSYS_STATUS_CACHE_TTL=0
# EPHAPSYS_LOG_LEVEL=WARNING
# EPHAPSYS_DEBUG=0

# PKI backend hint; normally set by the platform, not the SDK user.
# PKI_BACKEND=
